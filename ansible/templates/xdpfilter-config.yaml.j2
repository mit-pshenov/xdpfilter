schema_version: 2
# Generated by Ansible for {{ xdpfilter_iface }} — do not edit by hand.
# See docs/CONFIG_SCHEMA.md for the full schema reference (9-axis match model).
interface: {{ xdpfilter_iface }}
default_action: {{ xdpfilter_default_action }}
rules:
{% for rule in xdpfilter_rules %}
  - id: {{ rule.id }}
    action: {{ rule.action | default('pass') }}
    match:
{% if rule.mac is defined %}
      mac: "{{ rule.mac }}"
{% endif %}
{% if rule.dst_cidr is defined %}
      dst_cidr: "{{ rule.dst_cidr }}"
{% endif %}
{% if rule.src_cidr is defined %}
      src_cidr: "{{ rule.src_cidr }}"
{% endif %}
{% if rule.dst_cidr6 is defined %}
      dst_cidr6: "{{ rule.dst_cidr6 }}"
{% endif %}
{% if rule.src_cidr6 is defined %}
      src_cidr6: "{{ rule.src_cidr6 }}"
{% endif %}
{% if rule.protocol is defined %}
      protocol: "{{ rule.protocol }}"
{% endif %}
{% if rule.dst_port is defined %}
      dst_port: "{{ rule.dst_port }}"
{% endif %}
{% if rule.vlan is defined %}
      vlan: {{ rule.vlan }}
{% endif %}
{% if rule.ethertype is defined %}
      ethertype: "{{ rule.ethertype }}"
{% endif %}
{% endfor %}
